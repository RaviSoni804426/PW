installer/vendor/

# Local runtime state
mock-uploads/
recordings/
*.log

# Never commit these: they hold a device token and a fleet enrollment key
config.json
secrets.bin

# Editors / OS / tooling
.vscode/
.idea/
.claude/
.DS_Store
